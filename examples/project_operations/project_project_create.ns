language NSL "0.2";

skill PROJECT.PROJECT.CREATE {
    version "1.0.0";
    risk WRITE;
    requires { tool PROJECT.PROJECT.CREATE version "1.0.0"; }
    limits {
        tool_calls 1;
        loop_iterations 1;
        emitted_rows 1;
        collection_size 1;
    }
    input {
        tenant_id: String classification INTERNAL;
        requester_subject_id: String classification INTERNAL;
        project_id: String classification INTERNAL;
        project_code: ProjectCode classification INTERNAL;
        project_name: String classification INTERNAL;
        initial_owner_subject_id: String classification INTERNAL;
        initial_owner_membership_id: String classification INTERNAL;
        currency: String classification INTERNAL;
    }
    output {
        project_id: String classification INTERNAL;
        project_code: ProjectCode classification INTERNAL;
        name: String classification INTERNAL;
        status: String classification INTERNAL;
        entity_version: Int classification INTERNAL;
    }
    approve PROJECT_CREATE {
        message "Create the governed Project and initial OWNER membership?";
    }
    let project = write PROJECT.PROJECT.CREATE(
        tenant_id = tenant_id,
        requester_subject_id = requester_subject_id,
        project_id = project_id,
        project_code = project_code,
        project_name = project_name,
        initial_owner_subject_id = initial_owner_subject_id,
        initial_owner_membership_id = initial_owner_membership_id,
        currency = currency
    ) approved_by PROJECT_CREATE;
    emit {
        project_id: project.project_id;
        project_code: project.project_code;
        name: project.name;
        status: project.status;
        entity_version: project.entity_version;
    }
}
