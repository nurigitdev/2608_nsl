{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NSL v0.2.1 compatibility corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_version", "oracle_commit", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpus_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "not": {"pattern": "[^0-9.]"}
    },
    "oracle_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "minLength": 40, "maxLength": 40},
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/case_entry"}
    }
  },
  "$defs": {
    "category": {
      "enum": [
        "source", "contracts", "compile", "diagnostics", "nso", "values",
        "runtime", "write", "approval", "idempotency", "trust", "crypto",
        "audit", "replay", "integration"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "not": {"pattern": "[^a-z0-9_-]"}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "relative_path": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)*(/[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)*)*$",
      "not": {"pattern": "[^a-z0-9_./-]"}
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "named_files": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/file"}
    },
    "case_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "category", "path", "sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "category": {"$ref": "#/$defs/category"},
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "category", "contract_refs", "source_refs", "inputs", "expected_artifacts",
        "expected_status", "expected_error", "expected_hashes", "classification", "notes"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "category": {"$ref": "#/$defs/category"},
        "contract_refs": {"$ref": "#/$defs/references"},
        "source_refs": {"$ref": "#/$defs/references"},
        "inputs": {"$ref": "#/$defs/named_files"},
        "expected_artifacts": {"$ref": "#/$defs/named_files"},
        "expected_status": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_error": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {"type": "string", "pattern": "\\S"},
            "phase": {"type": "string", "pattern": "\\S"}
          }
        },
        "expected_hashes": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
        "notes": {"type": "string"}
      },
      "anyOf": [
        {"properties": {"expected_status": {"type": "string"}}},
        {"properties": {"expected_error": {"type": "object"}}},
        {"properties": {"expected_artifacts": {"minProperties": 1}}},
        {"properties": {"expected_hashes": {"minProperties": 1}}}
      ]
    }
  }
}
