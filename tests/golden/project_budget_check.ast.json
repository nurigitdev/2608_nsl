  "body": [
    {
      "node": "AstLet",
      "name": "parents",
      "value": {
        "node": "AstRead",
        "tool_id": "PROJECT.LIST_PARENT_PROJECTS",
        "arguments": [
          ["year", {"node": "AstPath", "parts": ["year"]}],
          ["team_id", {"node": "AstPath", "parts": ["team_id"]}]
        ]
      }
    },
    {
      "node": "AstForeach",
      "iterator": "parent",
      "collection": {"node": "AstPath", "parts": ["parents"]},
      "max_iterations": 10,
      "body": [
        {
          "node": "AstLet",
          "name": "children",
          "value": {
            "node": "AstRead",
            "tool_id": "PROJECT.LIST_CHILD_PROJECTS",
            "arguments": [
              [
                "parent_project",
                {"node": "AstPath", "parts": ["parent", "project_code"]}
              ],
              ["year", {"node": "AstPath", "parts": ["year"]}]
            ]
          }
        },
        {
          "node": "AstLet",
          "name": "spent",
          "value": {
            "node": "AstCall",
            "name": "sum",
            "arguments": [
              {"node": "AstPath", "parts": ["children", "expense_amount"]}
            ]
          }
        },
        {
          "node": "AstLet",
          "name": "remaining",
          "value": {
            "node": "AstBinary",
            "operator": "-",
            "left": {"node": "AstPath", "parts": ["parent", "budget"]},
            "right": {"node": "AstPath", "parts": ["spent"]}
          }
        },
        {
          "node": "AstCheck",
          "check_id": "BUDGET_LIMIT",
          "condition": {
            "node": "AstBinary",
            "operator": "<=",
            "left": {"node": "AstPath", "parts": ["spent"]},
            "right": {"node": "AstPath", "parts": ["parent", "budget"]}
          },
          "severity": "ERROR",
          "on_fail": "REPORT",
          "message": "자 프로젝트 지출 합계가 모 프로젝트 예산을 초과했습니다."
        },
        {
          "node": "AstEmit",
          "fields": [
            [
              "parent_project",
              {"node": "AstPath", "parts": ["parent", "project_code"]}
            ],
            ["budget", {"node": "AstPath", "parts": ["parent", "budget"]}],
            ["spent", {"node": "AstPath", "parts": ["spent"]}],
            ["remaining", {"node": "AstPath", "parts": ["remaining"]}],
            ["status", {"node": "AstPath", "parts": ["BUDGET_LIMIT", "status"]}]
          ]
        }
      ]
    }
  ]
